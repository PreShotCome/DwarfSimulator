# NiceHash API credentials. Create them at:
#   NiceHash → Settings → API Keys  (give the key "view" permissions only).
# These stay on the server and are NEVER sent to the browser.
NICEHASH_API_KEY=
NICEHASH_API_SECRET=
NICEHASH_ORG_ID=

# Optional overrides.
# PORT=4100
# NICEHASH_API_BASE=https://api2.nicehash.com
